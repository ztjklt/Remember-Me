{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NarrativeOverviewV1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "episode_id",
        "excerpt",
        "source_type",
        "temporal_context"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "SUBJECT",
            "THIRD_PARTY",
            "AI_INFERENCE",
            "OBJECTIVE",
            "CALIBRATION"
          ]
        },
        "temporal_context": {
          "type": "string"
        }
      }
    },
    "record": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "same_event": {
                "const": true
              }
            },
            "required": [
              "same_event"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "story"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "style",
                  "letter"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "facets": {
                "contains": {
                  "const": "EXPRESSION"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "story",
            "person",
            "observation",
            "letter",
            "style"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "facets": {
          "items": {
            "enum": [
              "EXPERIENCE",
              "RELATIONSHIPS",
              "IDENTITY",
              "PRACTICES",
              "VALUES",
              "FEELINGS",
              "WISHES",
              "EXPRESSION"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Facets",
          "type": "array",
          "uniqueItems": true
        },
        "time_text": {
          "default": "",
          "maxLength": 200,
          "title": "Time Text",
          "type": "string"
        },
        "place_text": {
          "default": "",
          "maxLength": 200,
          "title": "Place Text",
          "type": "string"
        },
        "aliases": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Aliases",
          "type": "array"
        },
        "same_event": {
          "default": false,
          "title": "Same Event",
          "type": "boolean"
        },
        "recipient_label": {
          "default": "",
          "maxLength": 120,
          "title": "Recipient Label",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "confirmed",
            "rejected",
            "stale"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "model_version": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "label": {
          "type": "string"
        },
        "historical": {
          "type": "boolean"
        },
        "source_valid": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "title",
        "text",
        "evidence_ids",
        "facets",
        "time_text",
        "place_text",
        "aliases",
        "same_event",
        "recipient_label",
        "id",
        "status",
        "revision",
        "model_version",
        "prompt_version",
        "created_at",
        "updated_at",
        "evidence",
        "label",
        "historical",
        "source_valid"
      ],
      "title": "RecordInput",
      "type": "object"
    }
  },
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "role": {
      "enum": [
        "owner",
        "reader"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "understandings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "context",
          "status",
          "evidence",
          "counter_evidence",
          "independent_events",
          "label"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "independent_events": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "counter_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "title",
          "records"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "facets": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "EXPERIENCE",
              "RELATIONSHIPS",
              "IDENTITY",
              "PRACTICES",
              "VALUES",
              "FEELINGS",
              "WISHES",
              "EXPRESSION"
            ]
          },
          "title": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "enabled",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "next_question": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "text",
            "reason"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    },
    "notice": {
      "type": "string"
    }
  },
  "required": [
    "subject_id",
    "role",
    "records",
    "source_evidence",
    "understandings",
    "views",
    "facets",
    "style",
    "next_question",
    "notice"
  ]
}
