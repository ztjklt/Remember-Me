{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remember-me.dev/contracts/voice-review-v1.schema.json",
  "title": "Owner review and retry of a generated voice",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "reviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "accepted"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "status",
        "reviewed_at",
        "previewed_at"
      ],
      "properties": {
        "profile_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "missing",
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "previewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "retryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retired_profile_id",
        "status"
      ],
      "properties": {
        "retired_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "retired"
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/reviewRequest"
    },
    {
      "$ref": "#/$defs/review"
    },
    {
      "$ref": "#/$defs/retryReceipt"
    }
  ]
}
