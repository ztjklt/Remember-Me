      "maxItems": 12,
      "title": "Aliases",
      "type": "array"
    },
    "same_event": {
      "default": false,
      "title": "Same Event",
      "type": "boolean"
    },
    "recipient_label": {
      "default": "",
      "maxLength": 120,
      "title": "Recipient Label",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "title",
    "text",
    "evidence_ids",
    "facets"
  ],
  "title": "RecordInput",
  "type": "object"
}
