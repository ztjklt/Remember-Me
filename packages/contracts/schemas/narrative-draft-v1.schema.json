{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "same_event": {
            "const": true
          }
        },
        "required": [
          "same_event"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "story"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "style",
              "letter"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "facets": {
            "contains": {
              "const": "EXPRESSION"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "kind": {
      "enum": [
        "story",
        "person",
        "observation",
        "letter",
        "style"
      ],
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "text": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array",
      "uniqueItems": true
    },
    "facets": {
      "items": {
        "enum": [
          "EXPERIENCE",
          "RELATIONSHIPS",
          "IDENTITY",
          "PRACTICES",
          "VALUES",
          "FEELINGS",
          "WISHES",
          "EXPRESSION"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Facets",
      "type": "array",
      "uniqueItems": true
    },
    "time_text": {
      "default": "",
      "maxLength": 200,
      "title": "Time Text",
      "type": "string"
    },
    "place_text": {
      "default": "",
      "maxLength": 200,
      "title": "Place Text",
      "type": "string"
    },
    "aliases": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
