REMEMBER_DATABASE_URL=sqlite:///./var/agent-loop.db
REMEMBER_OBJECT_STORE_ROOT=./var/object-store
REMEMBER_STT_BACKEND=http
REMEMBER_AI_BACKEND=http
REMEMBER_ENABLE_WORKBENCH=true
REMEMBER_STT_URL=http://127.0.0.1:8878
REMEMBER_AI_CORE_URL=http://127.0.0.1:8879
REMEMBER_STT_TIMEOUT_SECONDS=300
REMEMBER_AI_TIMEOUT_SECONDS=90
# Point to an installed binary and the multilingual model. No provider key here.
WHISPER_CLI=C:/path/to/whisper-cli.exe
WHISPER_MODEL_PATH=C:/path/to/ggml-base.bin

# Server-only cloud adapter; set key only in ignored .env.
AI_PROVIDER=weixin
AI_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
AI_MODEL=Deepseek-v4-flash
AI_MODEL_VERSION=Deepseek-v4-flash
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENT_REQUESTS=1
WEIXIN_CHAT_API_KEY=
