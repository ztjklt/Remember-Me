# Remember Me Backend — environment template.
#
# Copy it for local development:
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit a real credential, and never put a
# deployment secret in this file. Every key uses the REMEMBER_ prefix.
#
# One template serves every environment: a deployment overrides these variables
# in its own process environment rather than editing a copy of this file, because
# copies drift. See infra/deployment.md for the environments and
# infra/migrations.md for the schema step.
# See docs/architecture/backend-adr.md for why each setting exists.

# development | staging | test
# The value appears in every log line, so a process in the wrong environment is
# visible rather than silent.
REMEMBER_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
REMEMBER_LOG_LEVEL=INFO

# Deployment supplies PostgreSQL, for example:
#   postgresql+psycopg://user:password@db-host:5432/remember_me
# The driver is a deployment prerequisite rather than a repository dependency:
#   uv add "psycopg[binary]"
# The DSN carries a credential, so a deployment supplies it from its secret
# mechanism and a developer never commits one.
# SQLite is the local development and test default. The directory in the path
# must exist before the first migration; see the README run steps.
REMEMBER_DATABASE_URL=sqlite:///./var/remember-me.db

# local | memory
# The S3-compatible deployment backend arrives with Issue #1, which owns the
# audio object path.
REMEMBER_OBJECT_STORE_BACKEND=local
REMEMBER_OBJECT_STORE_ROOT=./var/object-store

# Give a second environment its own database and its own store root, so it cannot
# reach the first environment's data:
#
#   REMEMBER_DATABASE_URL=sqlite:///./var/staging/remember-me.db
#   REMEMBER_OBJECT_STORE_ROOT=./var/staging/object-store