# Remember Me Backend — environment template.
#
# Copy it for local development:
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit a real credential, and never put a
# deployment secret in this file. Every key uses the REMEMBER_ prefix.
#
# One template serves every environment: a deployment overrides these variables
# in its own process environment rather than editing a copy of this file, because
# copies drift. See infra/deployment.md for the environments and
# infra/migrations.md for the schema step.
# See docs/architecture/backend-adr.md for why each setting exists.

# development | staging | test
# The value appears in every log line, so a process in the wrong environment is
# visible rather than silent.
REMEMBER_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
REMEMBER_LOG_LEVEL=INFO

# Deployment supplies PostgreSQL, for example:
#   postgresql+psycopg://user:password@db-host:5432/remember_me
# The driver is a deployment prerequisite rather than a repository dependency:
#   uv add "psycopg[binary]"
# The DSN carries a credential, so a deployment supplies it from its secret
# mechanism and a developer never commits one.
# SQLite is the local development and test default. The directory in the path
# must exist before the first migration; see the README run steps.
REMEMBER_DATABASE_URL=sqlite:///./var/remember-me.db

# local | memory | s3
# local and memory are for development, CI, and tests. Deployment uses the
# S3-compatible backend, which is one adapter for AWS S3, MinIO, and anything
# else that speaks the same API.
REMEMBER_OBJECT_STORE_BACKEND=local
REMEMBER_OBJECT_STORE_ROOT=./var/object-store

# The bucket the audio is written to, and the endpoint when it is not AWS.
# Setting an endpoint switches the client to path-style addressing, because a
# local MinIO has no bucket.<host> DNS record.
REMEMBER_OBJECT_STORE_BUCKET=remember-me-audio
REMEMBER_OBJECT_STORE_ENDPOINT_URL=
REMEMBER_OBJECT_STORE_REGION=us-east-1

# The largest upload the boundary accepts, in bytes. The Android client enforces
# its own limit too; this is the one a client cannot bypass.
REMEMBER_MAX_UPLOAD_BYTES=26214400

# No provider is frozen yet, so these name an adapter rather than a vendor.
#
# stt_backend: fake | http | dashscope
#   fake is deterministic and says it is a fake — it runs no speech
#   recognition. It is refused outside development and test, so a deployment
#   that forgot to configure a real provider fails at startup rather than
#   filling the record with placeholder transcripts.
#   http posts the audio itself to the provider and reads the transcript back.
REMEMBER_STT_BACKEND=fake
REMEMBER_STT_URL=http://127.0.0.1:8200
# The provider's URL path belongs to the provider, not to the contract: the
# contract fixes the payload shapes, not the endpoint. Set it to whatever the
# speech-to-text service exposes, without a code change here. The request is
# POST <url><path> with the audio as the body and the audio's content type as
# the Content-Type header; the answer is JSON with a "text" string, and a
# "model_version" string if the provider reports one.
REMEMBER_STT_PATH=/transcribe
REMEMBER_STT_TIMEOUT_SECONDS=60
# dashscope uses the native /api/v1/services/aigc/multimodal-generation/generation
# path on the workspace host, not the OpenAI-compatible chat endpoint.
REMEMBER_STT_MODEL=
REMEMBER_STT_API_KEY=

# ai_backend: fake | http
#   fake is the same kind of stand-in as above, and is refused outside
#   development and test.
#   http posts an aiCoreInput to AI Core and validates the answer against the
#   contract before anything is stored.
REMEMBER_AI_BACKEND=fake
REMEMBER_AI_CORE_URL=http://127.0.0.1:8100
# AI Core's URL path belongs to AI Core, not to the contract: the contract fixes
# the payload shapes, not the endpoint. Set it to whatever the AI Core service
# exposes, without a code change here.
REMEMBER_AI_CORE_PATH=/process
REMEMBER_AI_TIMEOUT_SECONDS=30

# The one way a fake provider may run outside development and test. Set it to
# true to bring an environment up end to end before its real provider is
# reachable; every process that builds a fake logs a WARNING saying so, so an
# environment running on placeholders is stated rather than inferred. Leave it
# unset in any environment whose record is meant to be real.
REMEMBER_ALLOW_FAKE_PROVIDERS=false

# The worker runs one stage per tick, so each transition is committed on its
# own and is visible from outside the process. The retry budget is per stage: a
# stage that keeps failing ends the Episode as failed, and a stage that
# succeeded does not spend the next stage's attempts.
#
# The lease is what lets more than one worker run. A worker renews it while its
# stage runs, and commits the stage's result only while it still holds it — so a
# stage that outlives its lease is retried elsewhere rather than written twice.
# Size it below the longest stage you expect, not above: renewal is cheap and a
# lease longer than the work only delays recovery from a worker that died.
REMEMBER_JOB_MAX_ATTEMPTS=3
REMEMBER_JOB_RETRY_BACKOFF_SECONDS=5
REMEMBER_JOB_LEASE_SECONDS=60

# Give a second environment its own database and its own store root, so it cannot
# reach the first environment's data:
#
#   REMEMBER_DATABASE_URL=sqlite:///./var/staging/remember-me.db
#   REMEMBER_OBJECT_STORE_ROOT=./var/staging/object-store
# User-authorized Agent prototype. Old /api/v1 behavior remains available.
REMEMBER_AGENT_ENABLED=false
REMEMBER_AGENT_TIMEOUT_SECONDS=45
