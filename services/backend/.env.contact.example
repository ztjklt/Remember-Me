# Merge into the server environment; never commit real values.
# Generate once with Fernet.generate_key(), back up privately and retain across restarts.
REMEMBER_CONTACT_ENTRUSTMENT_KEY=
REMEMBER_CONTACT_ENTRUSTMENT_PUBLIC_URL=https://your-api.example.com

# SMTP over TLS; use 587 + starttls if your provider requires it.
REMEMBER_CONTACT_SMTP_HOST=
REMEMBER_CONTACT_SMTP_PORT=465
REMEMBER_CONTACT_SMTP_TLS=ssl
REMEMBER_CONTACT_SMTP_USERNAME=
REMEMBER_CONTACT_SMTP_PASSWORD=
REMEMBER_CONTACT_SMTP_FROM=

# Optional Aliyun SMS. Approved sign + code template required.
# Code template parameter: ${code}; notice template parameter: ${url}.
# No SMS account is automatically opened or charged by setup.
REMEMBER_CONTACT_SMS_ACCESS_KEY_ID=
REMEMBER_CONTACT_SMS_ACCESS_KEY_SECRET=
REMEMBER_CONTACT_SMS_SIGN_NAME=
REMEMBER_CONTACT_SMS_CODE_TEMPLATE=
REMEMBER_CONTACT_SMS_NOTICE_TEMPLATE=
