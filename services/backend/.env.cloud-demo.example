# Local real-model development only. Copy to .env and configure secrets locally.
# This database is separate from ECS. Never run tests against the ECS database.
REMEMBER_ENVIRONMENT=development
REMEMBER_DATABASE_URL=sqlite:///./var/remember-me.db
REMEMBER_OBJECT_STORE_BACKEND=local
REMEMBER_OBJECT_STORE_ROOT=./var/object-store
REMEMBER_ENABLE_WORKBENCH=true
REMEMBER_ALLOW_ACCOUNT_REGISTRATION=false
REMEMBER_ALLOW_FAKE_PROVIDERS=false
REMEMBER_STT_BACKEND=paraformer
# Host only, no /compatible-mode/v1 path. Blank configuration fails explicitly.
REMEMBER_PARAFORMER_BASE_URL=
REMEMBER_PARAFORMER_API_KEY=
REMEMBER_PARAFORMER_STATE_DIR=./var/paraformer-asr
REMEMBER_PARAFORMER_POLL_TIMEOUT_SECONDS=120
REMEMBER_STT_TIMEOUT_SECONDS=45
REMEMBER_AI_BACKEND=http
REMEMBER_AI_CORE_URL=http://127.0.0.1:8879
REMEMBER_AI_TIMEOUT_SECONDS=90
