# Fresh local Twin workspace. Copy to .env only if that file does not exist.
# Relative storage paths resolve from services/backend; no A01 data is seeded.
REMEMBER_ENVIRONMENT=development
REMEMBER_LOG_LEVEL=INFO
REMEMBER_ENABLE_WORKBENCH=true
REMEMBER_ALLOW_ACCOUNT_REGISTRATION=false
REMEMBER_ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]","10.0.2.2"]
REMEMBER_DATABASE_URL=sqlite:///./var/twin-local/remember.db
REMEMBER_OBJECT_STORE_BACKEND=local
REMEMBER_OBJECT_STORE_ROOT=./var/twin-local/object-store

# Fake ASR is only a wiring fixture; it does not recognize uploaded speech.
REMEMBER_STT_BACKEND=fake
REMEMBER_AI_BACKEND=http
REMEMBER_AI_CORE_URL=http://127.0.0.1:8892
REMEMBER_AI_TIMEOUT_SECONDS=100
REMEMBER_JOB_MAX_ATTEMPTS=3
REMEMBER_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# For real ASR, change STT_BACKEND to paraformer and privately fill both fields.
# Base URL must be your Beijing workspace HTTPS host, without a path; see guide.
REMEMBER_PARAFORMER_API_KEY=
REMEMBER_PARAFORMER_BASE_URL=
REMEMBER_PARAFORMER_STATE_DIR=./var/twin-local/paraformer-asr

# Optional fictional synthetic voice: disabled until all private prerequisites
# are configured AND the owner separately grants VOICE and enrolls the preset.
REMEMBER_VOICE_SYNTHETIC_BACKEND=disabled
REMEMBER_XIAOMI_VOICE_API_KEY=
REMEMBER_XIAOMI_VOICE_BASE_URL=https://api.xiaomimimo.com/v1
REMEMBER_XIAOMI_VOICE_MODEL=mimo-v2.5-tts-voiceclone
REMEMBER_A01_VOICE_SUBJECT_ID=
REMEMBER_A01_VOICE_REFERENCE_PATH=

# The separate local Voice sidecar is optional and is not started by this guide.
REMEMBER_VOICE_URL=http://127.0.0.1:8300
REMEMBER_VOICE_TIMEOUT_SECONDS=180
