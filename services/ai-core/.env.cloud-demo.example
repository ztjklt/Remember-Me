# Text processing only. This is not an audio or image endpoint.
AI_PROVIDER=weixin
AI_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
AI_MODEL=Deepseek-v4-flash
AI_MODEL_VERSION=Deepseek-v4-flash
WEIXIN_CHAT_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENT_REQUESTS=1
AI_TWIN_QUOTE_ANSWERS=true
AI_TWIN_VERIFY_ANSWERS=true
