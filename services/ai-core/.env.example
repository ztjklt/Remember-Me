# Fresh local AI Core. Copy to .env only if that file does not exist.
# Fixture mode makes no provider calls and supports deterministic extraction.
# It does NOT provide Persona, profile proposals, narrative or real Twin answers.
REMEMBER_ENVIRONMENT=development
AI_PROVIDER=fixture
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENT_REQUESTS=1
AI_TWIN_VERIFY_ANSWERS=true
AI_TWIN_QUOTE_ANSWERS=true
AI_TWIN_STRUCTURED_ANSWERS=false
AI_PROFILE_VERIFY_CANDIDATES=true
AI_PERSONA_TOTAL_TIMEOUT_SECONDS=90
AI_PERSONA_CALL_TIMEOUT_SECONDS=45
AI_PERSONA_FICTIONAL_DEBUG_TRACE=false

# For the implemented Persona/profile/narrative route, change AI_PROVIDER to
# weixin and privately fill WEIXIN_CHAT_API_KEY. That adapter supplies its exact
# approved endpoint/model defaults; do not copy credentials from another checkout.
WEIXIN_CHAT_API_KEY=
# AI_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
# AI_MODEL=Deepseek-v4-flash
# AI_MODEL_VERSION=Deepseek-v4-flash

# Other extraction adapters may use this field; it is NOT a replacement for the
# Weixin credential. Prompt/schema versions should use the code's own defaults.
AI_API_KEY=

# Streamed Twin: with retry enabled, one shared deadline covers serial attempts.
# Other paths use their own retry policy. The measured streamed trial used 3s.
AI_VOICE_CALL_TIMEOUT_SECONDS=8
AI_VOICE_RETRY_AFTER_SECONDS=0
# Optional reviewed-JSON retry delay; unset inherits the setting above.
# Close the first request before retrying; both share the 8-second stage budget.
# AI_VOICE_JSON_RETRY_AFTER_SECONDS=3
