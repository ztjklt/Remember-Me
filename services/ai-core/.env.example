AI_ENVIRONMENT=development
AI_AGENT_ENABLED=false
# fixture is only for deterministic offline tests; real adapter never falls back to it.
AI_PROVIDER=fixture
AI_MODEL=fixture-ai-v2
AI_MODEL_VERSION=fixture-ai-v2
AI_BASE_URL=http://127.0.0.1:8000/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
# Optional compatible-provider extension; omit for providers without this field.
# Set false for the verified Qwen structured extraction deployment.
# AI_ENABLE_THINKING=false
AI_MAX_CONCURRENT_REQUESTS=4
