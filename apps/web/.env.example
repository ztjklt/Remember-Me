# Server settings only. Never copied into the browser build.
HOST=127.0.0.1
PORT=8770
WEB_PUBLIC_ORIGIN=http://127.0.0.1:8770
WEB_BACKEND_URL=https://39.108.183.47
WEB_BACKEND_CA=../../apps/android/app/src/internal/res/raw/remember_ecs_ip_demo.pem
# Optional: existing public fictional demonstration accounts, not admin accounts.
# Omit these four values to require ordinary account login.
WEB_DEMO_READER_USER=
WEB_DEMO_READER_PASSWORD=
WEB_DEMO_OWNER_USER=
WEB_DEMO_OWNER_PASSWORD=
# Exact dedicated subject for /app/. Empty means ordinary workbench entry.
WEB_DEMO_SUBJECT_ID=
# Set 1 when using a private local account; requires loopback host/origin.
WEB_PRIVATE_DEMO=0
# Optional: verified current release URL. No unverified APK URL is shown.
WEB_APK_URL=
