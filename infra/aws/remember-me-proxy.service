[Unit]
Description=Remember Me HTTPS entry
After=network-online.target remember-me@api.service
Wants=network-online.target

[Service]
User=caddy
Group=caddy
EnvironmentFile=/etc/remember-me/proxy.env
Environment=HOME=/var/lib/caddy
ExecStart=/usr/bin/caddy run --config /opt/remember-me/current/infra/aws/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /opt/remember-me/current/infra/aws/Caddyfile --adapter caddyfile
TimeoutStopSec=10
Restart=on-failure
StateDirectory=caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy

[Install]
WantedBy=multi-user.target
