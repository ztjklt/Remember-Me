# Fill these only in the dedicated CloudBase environment's secret settings.
CLOUDBASE_ENV_ID=
REMEMBER_DEPLOYMENT_SCOPE=ios-cloudbase
REMEMBER_RELEASE_ID=ios-cloudbase-internal
# JSON list containing the actual deployed API hostname, 127.0.0.1 and localhost.
# Do not use a global wildcard. Configure after the service hostname is known.
REMEMBER_ALLOWED_HOSTS=
REMEMBER_DATABASE_URL=
# Optional public CA certificate downloaded from the database control panel.
# Connections always use verify-full and the private remember_ios schema.
REMEMBER_POSTGRES_CA_PEM=
REMEMBER_OBJECT_STORE_BACKEND=cloudbase
REMEMBER_OBJECT_STORE_BUCKET=remember-me-ios-audio
REMEMBER_CLOUDBASE_API_KEY=
# Alternative: select s3 and supply a separate private COS bucket and credentials.
REMEMBER_OBJECT_STORE_REGION=ap-shanghai
REMEMBER_OBJECT_STORE_ENDPOINT_URL=https://cos.ap-shanghai.myqcloud.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# If temporary COS credentials are used, also configure AWS_SESSION_TOKEN.
CLOUDBASE_WORKER_TOKEN=
REMEMBER_STT_BACKEND=relay
REMEMBER_RELAY_ASR_URL=https://ai-router-cn-pub.anker-in.com/chat/completions
REMEMBER_RELAY_ASR_MODEL=hackathon/v_model/qwen-audio-3.0-asr-flash
REMEMBER_RELAY_ASR_API_KEY=
# Provisional audio wire format; real ASR capability remains to be verified.
REMEMBER_RELAY_ASR_FORMAT=input_audio
REMEMBER_RELAY_ASR_CHECKPOINT_BACKEND=object_store
# Alternative: explicitly select paraformer and use its separate Bailian credential.
REMEMBER_PARAFORMER_BASE_URL=
REMEMBER_PARAFORMER_API_KEY=
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_MODEL_VERSION=deepseek-flash
AI_API_KEY=
# Alternative adapters remain explicit: anker (event router) or weixin.
# Memory, Twin and profile workers use the same selected main model.
# Voice generation stays unavailable until a separately approved adapter is deployed.
