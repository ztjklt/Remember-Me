      "id": "nr_3d0cabff453f4f118d1b",
      "kind": "person",
      "title": "陈岚",
      "text": "陈岚是陈守义的女儿。小时候放学回家，她把书包放在门边，去厨房找妈妈孙玉琴；吃饭时愿意讲学校的事。后来她问父亲为什么总说“平安回家比多跑一趟重要”，父亲先想了想，再用厨房留灯的日常回应。她提议陪父亲去老车队，但时间和父亲当天是否愿意出门都还没定。",
      "evidence_ids": [
        "ev_da25f6dedecf40fe",
        "ev_afc9280f22d247af",
        "ev_b0b9ccb798ea44a0",
        "ev_735212b22d994af5",
        "ev_140acf3cef8e4fff",
        "ev_47d01b9d66e74bad"
      ],
      "facets": [
        "RELATIONSHIPS"
      ],
      "time_text": "",
      "place_text": "南京",
      "aliases": [
        "陈岚"
      ],
      "same_event": false,
      "recipient_label": "",
      "status": "confirmed",
      "revision": 5,
      "model_version": "Deepseek-v4-flash",
